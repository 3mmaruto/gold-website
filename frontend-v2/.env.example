# Public build-time values only. Never put API/Turnstile secrets in VITE_*.
# Disabled until the exact ERP endpoint and approved production site key are set.
VITE_GOLD_ERP_INTAKE_URL=
VITE_GOLD_TURNSTILE_SITE_KEY=

# Enable only after the ERP private PDF/scanning policy has been verified.
VITE_GOLD_INTAKE_PDF_ENABLED=false

# Explicit development bypass: BOTH the website and API must be loopback URLs.
# Example endpoint: http://127.0.0.1:8000/api/public/v1/quote-requests
# This never enables HTTP LAN, tunnels or production hosts.
VITE_GOLD_INTAKE_LOCAL_ONLY=false

# CI publication gate (not bundled). Leave false for local preview builds.
# Main release requires an explicit enabled/disabled choice; empty fails closed.
GOLD_WEBSITE_RELEASE=false
GOLD_WEBSITE_RELEASE_INTAKE=
# Required for enabled releases: approved website HTTPS origin, no route/query.
GOLD_WEBSITE_PUBLIC_ORIGIN=
